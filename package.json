{
  "name": "saas-turismo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run db:test:local && npm run build",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked > src/server/db/database.types.ts",
    "db:test": "supabase test db",
    "db:test:local": "node scripts/db-test-local.mjs",
    "db:test:remote": "node scripts/db-test-remote.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
