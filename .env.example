# Copie para .env.local e preencha. Nunca versione valores reais.
# Detalhes de cada variável: ENVIRONMENT.md

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Segredos da aplicação (openssl rand -base64 32) ---
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1
PROPOSAL_TOKEN_PEPPER=
IP_HASH_SALT=
CRON_SECRET=

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_AGENT=claude-opus-5
ANTHROPIC_MODEL_AUX=claude-opus-5
ANTHROPIC_AGENT_EFFORT=medium
AI_MAX_TOOL_ITERATIONS=5

# --- Meta WhatsApp Cloud API ---
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
# Somente desenvolvimento (número de teste). Em produção os tokens ficam por agência, criptografados no banco.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

